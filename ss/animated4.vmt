"UnlitGeneric"
{
	"$basetexture" "vgui/replay/thumbnails/animated4d"
	"$translucent" 1
	"$vertexcolor" 1
	"$no_fullbright" 1
	"$ignorez" 1
	"$speed" 0
    "$basetexturetransform" "center .5 .5 scale 4.2 4.2 rotate 0 translate 0 0"
	"$alpha" "1"
	"$color" "[1 1 1]"
	Proxies {
		PlayerSpeed {
			scale "1"//0.5
			resultVar $speed
		}
		Clamp {
			min 0
			max 500
			srcVar1 $speed
			resultVar $frame
		}
	}
}
