"Modulate"
{
	"$baseTexture" "vgui/replay/thumbnails/modulatetest2"
	"$vertexalpha" 1
	"$translucent" 1
	"$additive" 1
	"$scaleamount" "[-1 1]"
	    "Proxies"
		{
	          "AnimatedTexture"
	          {
                                             "animatedtexturevar" "$basetexture"
                                             "animatedtextureframenumvar" "$frame"
                                             "animatedtextureframerate" 25
	          }
			   "TextureTransform"
	          {
                                             "scaleVar" "$scaleamount"
                                             "resultVar" "$basetexturetransform"	          
              }
     }
}